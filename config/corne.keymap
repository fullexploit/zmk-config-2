#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                          &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | SHFT | BRD | BRI | MUT | VDN | VUP |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | TOG | EFF | PGD | PGU | INS | CAPS |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1                &kp N2                &kp N3        &kp N4             &kp N5             &kp N6           &kp N7           &kp N8            &kp N9             &kp N0                &kp BSPC
&kp LSHIFT  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &kp MINUS        &kp EQUAL        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp GRAVE
&bt BT_CLR  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4       &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &kp PAGE_DOWN     &kp PAGE_UP        &kp INSERT            &kp CAPSLOCK
                                                        &kp LGUI      &trans             &kp SPACE          &kp RET          &trans           &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 | BSPC |
            // | SHFT | F11 | F12 | BRA |     |     |   | LEFT| DOWN|  UP |RIGHT| DEL | LOCK |
            // | CTRL | PRNT|     |     |     |     |   | APP |PPREV|PNEXT| HOME| END |LAYOUT|
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp F1           &kp F2   &kp F3                 &kp F4  &kp F5       &kp F6          &kp F7            &kp F8        &kp F9           &kp F10  &kp BSPC
&kp LSHIFT  &kp F11          &kp F12  &kp C_BRIGHTNESS_AUTO  &trans  &trans       &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW  &kp RIGHT_ARROW  &kp DEL  &kp C_AL_LOCK
&kp LCTRL   &kp PRINTSCREEN  &trans   &trans                 &trans  &kp K_APP    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp HOME         &kp END  &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT
                                      &kp LGUI               &trans  &kp SPACE    &kp RET         &trans            &kp RALT
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |      |     |     |     |     |     |   |     |     |     |     |     | koff |
            // | RGTOG| HUE+| SAT+| BRI+|     |     |   |     |     |     |     |     |      |
            // | RGEFF| HUE-| SAT-| BRI-|     |     |   |     |     |     |     |     | poff |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans           &trans           &trans           &trans           &trans  &trans       &trans   &trans  &trans    &trans  &trans  &soft_off
&rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &trans  &trans       &trans   &trans  &trans    &trans  &trans  &trans
&rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &trans  &trans       &trans   &trans  &trans    &trans  &trans  &kp C_POWER
                                                   &kp LGUI         &trans  &kp SPACE    &kp RET  &trans  &kp RALT
            >;
        };
    };
};
